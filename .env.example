# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5001
DEBUG=false

# ── Inference ─────────────────────────────────────────────────────────────
TOP_N_PREDICTIONS=5
CONFIDENCE_THRESHOLD=0.0
MAX_FILE_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
BATCH_MAX_IMAGES=16

# ── Model artifacts (leave defaults for the original Drive links) ─────────
# EXPORT_FILE_URL=https://storage.example.com/cattle_breed_classifier_full_model.pth
# EXPORT_CLASSES_URL=https://storage.example.com/classes.txt
# EXPORT_FILE_NAME=cattle_breed_classifier_full_model.pth
# EXPORT_CLASSES_NAME=classes.txt

# ── Security ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
URL_FETCH_TIMEOUT_S=10
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*
